{
  "name": "ocp-simulator",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:ocp-simulator": "node dist/ocp-simulator/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
